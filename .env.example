# TwitterAPI.io
TWITTER_API_KEY=
TWITTER_API_BASE_URL=https://api.twitterapi.io

# SQLite file. Use :memory: only for tests.
DB_PATH=./data/xradar.db

# grok-build is invoked with this directory as its cwd.
# Never point this at the repo root: the CLI indexes the working directory.
GROK_WORKSPACE_DIR=./workspace
GROK_BIN_PATH=grok-build

# Optional. When either value is empty, Telegram delivery is skipped.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Tests point this at a local mock. Leave it unset in production.
# TELEGRAM_API_BASE_URL=https://api.telegram.org

# Host path mounted into the x-radar container. See docker-compose.yml.
HOST_GROK_BIN_PATH=/usr/local/bin/grok-build
